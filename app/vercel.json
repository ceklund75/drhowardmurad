{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*wp-json.*)",
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "/(.*)",
      "missing": [
        {
          "type": "header",
          "key": "user-agent"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": "(?i)(curl|wget|python-requests|scrapy|go-http-client|libwww-perl)"
          }
        }
      ],
      "mitigate": {
        "action": "challenge"
      }
    },
    {
      "src": "/(.*)",
      "missing": [
        {
          "type": "header",
          "key": "accept"
        }
      ],
      "mitigate": {
        "action": "challenge"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ja4-digest",
          "value": {
            "re": "^t1[23]d\\d{4}00_"
          }
        }
      ],
      "mitigate": {
        "action": "challenge"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
